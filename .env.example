# ==============================================================================
# Environment Configuration for Raspberry Pi Deployment
# Copy this file to .env before starting: cp .env.example .env
# ==============================================================================

# Docker image published to GitHub Container Registry (GHCR)
# IMPORTANT: Replace 'kubiv' with your GitHub username (always lowercase)
PERSONAL_WEB_IMAGE=ghcr.io/kubiv/personal-web:latest

# Cloudflare Zero Trust Tunnel Token
# Create a tunnel in Cloudflare Zero Trust Dashboard: Networks -> Tunnels
# Copy the token string from the tunnel install command and paste it below
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Host user and group ID on Raspberry Pi (run `id -u` and `id -g` to check, typically 1000)
UID=1000
GID=1000

# Optional: Host address or domain origin for SvelteKit CSRF checks (if needed)
# ORIGIN=https://yourdomain.com
